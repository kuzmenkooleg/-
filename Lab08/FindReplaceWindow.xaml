<Window x:Class="Lab08.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        Height="270"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F3F0EA"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#EDF3EF"/>
            <Setter Property="Foreground" Value="#222625"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#D6D0C4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>
    <Border Margin="14" Background="#FFFCF7" CornerRadius="10" Padding="18" BorderBrush="#E1DDD4" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="128"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Scriptum Desk" Foreground="#007C78" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <TextBlock x:Name="FindLabel" Grid.Row="1" Grid.Column="0" Margin="0,5,12,10" VerticalAlignment="Center" Foreground="#68706C"/>
            <TextBox x:Name="FindBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>
            <TextBlock x:Name="ReplaceLabel" Grid.Row="2" Grid.Column="0" Margin="0,5,12,10" VerticalAlignment="Center" Foreground="#68706C"/>
            <TextBox x:Name="ReplaceBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>
            <CheckBox x:Name="MatchCaseBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12" Foreground="#222625"/>
            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="FindButton" Click="FindButton_Click" Background="#007C78" Foreground="White"/>
                <Button x:Name="ReplaceButton" Click="ReplaceButton_Click"/>
                <Button x:Name="ReplaceAllButton" Click="ReplaceAllButton_Click"/>
                <Button x:Name="CloseButton" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
